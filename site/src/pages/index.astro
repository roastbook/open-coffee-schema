---
import Layout from "@roastbook/ui/astro/Layout.astro";
import { buildDate, contextsOf, familyNames, families, latestOf } from "../lib/data.ts";
import { BASE_URL } from "../../../lib/schemas.ts";
import "../styles/site.css";

const familyCopy: Record<string, { title: string; description: string }> = {
  "coffee-places": { title: "Coffee places", description: "Cafés, roasteries and coffee bars. Describe their location, coffee, opening hours and amenities." },
  "brew-methods": { title: "Brew methods", description: "From espresso to pour-over. Define brewing techniques, parameters and what a journal should record." },
  "pour-patterns": { title: "Pour patterns", description: "How the water goes on: flow patterns, kettle movements and named recipes such as the 4:6 method, as timed phases." },
  equipment: { title: "Equipment", description: "Machines, grinders and brewing tools. A consistent catalog of models and their specifications." },
  common: { title: "Common definitions", description: "The building blocks behind every schema: identifiers, sources, links and shared values." },
};
const recordPreview = `{
  "name": "Corner Café",
  "serving": {
    "espresso": true,
    "filter": true
  },
  "amenities": {
    "wifi": true
  }
}`;
const cp = latestOf("coffee-places");
const quickStart = `curl -sSO ${cp.expectedId}
curl -sSO ${BASE_URL}common/common.schema.v${latestOf("common").version}.json
curl -sSO https://data.roastbook.coffee/datasets/coffee-places/de/munich.json

bunx -p ajv-cli@5 -p ajv-formats@3 ajv validate --spec=draft2020 --strict=true -c ajv-formats \\
  -s ${cp.fileName} -r common.schema.v${latestOf("common").version}.json -d munich.json`;
---
<Layout title="An open standard for coffee data" description="JSON Schema, JSON-LD context and plain-language docs for coffee places, equipment, brew methods and pour patterns." site="schema" version={cp.version} buildDate={buildDate} canonical={BASE_URL}>
  <section class="schema-hero" aria-labelledby="intro-title">
    <div class="schema-hero-copy">
      <p class="schema-release"><span class="badge">JSON Schema</span> <span>Open standard · v{cp.version}</span></p>
      <h1 id="intro-title">Open Coffee Schema</h1>
      <p class="lead">Coffee places, brewing methods and equipment, described in a format everyone can use.</p>
      <p class="muted">Explore the fields, compare versions or check your own data. Published versions have permanent addresses and never change.</p>
      <div class="actions">
        <a class="button" data-variant="primary" href="/coffee-places/latest/">Explore the schema</a>
        <a class="button" href="/playground/">Validate your data</a>
      </div>
    </div>
    <figure class="schema-preview">
      <figcaption><span>Inside a coffee place</span><code>JSON</code></figcaption>
      <pre><code>{recordPreview}</code></pre>
      <p>An excerpt. <a href="/coffee-places/latest/#field">Every field has a definition.</a></p>
    </figure>
  </section>

  <section aria-labelledby="families">
    <div class="section-heading">
      <h2 id="families">Explore the schemas</h2>
      <p>Versioned definitions. Ready for your app.</p>
    </div>
    <ul class="families">
      {familyNames.map((family) => {
        const latest = latestOf(family), copy = familyCopy[family];
        return (
          <li class="card family-card">
            <div class="family-heading">
              <h3><a href={`/${family}/latest/`}>{copy?.title ?? family}</a></h3>
              <span class="badge tabular">v{latest.version}</span>
            </div>
            <p>{copy?.description}</p>
            <div class="family-links">
              <a href={`/${family}/${latest.fileName}`}>Download JSON</a>
              <a href={`/${family}/diff/`}>Compare {families.get(family)!.length} versions</a>
              {family !== "common" && <a href={`/playground/?schema=${family}@${latest.version}`}>Try it</a>}
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="standard-note" aria-labelledby="what">
    <h2 id="what">One format, wherever your data goes</h2>
    <p>A data file names its exact version in <code>$schema</code>, so any JSON Schema validator can check it. Coffee places also have a <a href={`/coffee-places/${contextsOf("coffee-places").at(-1)}`}>JSON-LD context</a> for schema.org. See the standard in use in the <a href="https://data.roastbook.coffee/">Open Coffee dataset</a>.</p>
  </section>

  <section aria-labelledby="quick-start">
    <h2 id="quick-start">Quick start</h2>
    <p>Each schema is served at its <code>$id</code>. Download the schema and the shared definitions it references, then validate a data file:</p>
    <pre><code>{quickStart}</code></pre>
    <p>In JavaScript, <code>@roastbook/open-coffee-schema</code> (on npm: <code>bun add @roastbook/open-coffee-schema</code>, <a href="https://github.com/Roastbook/open-coffee-schema/tree/main/packages/schema#install">install guide</a>) gives you TypeScript types, the schema files for Ajv and the allowed values of every list. To link to a field, use <code>{BASE_URL}coffee-places/latest/#field-serving.filter</code>; the path after <code>field-</code> is relative to one record.</p>
  </section>
</Layout>
