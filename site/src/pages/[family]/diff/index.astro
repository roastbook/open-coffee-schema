---
import Layout from "@roastbook/open-coffee-ui/Layout.astro";
import FamilyNav from "../../../components/FamilyNav.astro";
import { buildDate, families, latestOf } from "../../../lib/data.ts";
import "../../../styles/site.css";

export const getStaticPaths = () => [...families.keys()].map((family) => ({ params: { family } }));
const { family } = Astro.params;
const versions = families.get(family)!.map((f) => f.version);
const pairs = versions.flatMap((a, i) => versions.slice(i + 1).map((b) => [a, b])).reverse();
---
<Layout title={`Compare ${family} versions`} site="schema" version={latestOf(family).version} buildDate={buildDate}>
  <p class="eyebrow"><a href="/">Schemas</a> / <a href={`/${family}/latest/`}>{family}</a></p>
  <h1>Compare {family} versions</h1>
  <FamilyNav family={family} current="diff" />
  {pairs.length === 0
    ? <p class="card">Only one version (v{versions[0]}) exists, so there is nothing to compare yet. Each new version gets a structural comparison with every earlier one here.</p>
    : <ul class="pairs">{pairs.map(([a, b]) => <li><a href={`/${family}/diff/v${a}...v${b}/`}>v{a} → v{b}</a></li>)}</ul>}
</Layout>
