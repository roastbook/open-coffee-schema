{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.roastbook.coffee/translations/translations.schema.v1.0.0.json",
  "title": "Open Coffee translations",
  "description": "Translated text fields for one dataset file, keyed by record id. Untranslated records fall back to the base file.",
  "type": "object",
  "required": ["$schema", "meta", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "pattern": "^https://schema\\.roastbook\\.coffee/translations/translations\\.schema\\.v[0-9]+\\.[0-9]+\\.[0-9]+\\.json$" },
    "meta": {
      "type": "object",
      "allOf": [{ "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/dataset_meta" }],
      "required": ["locale", "base"],
      "properties": {
        "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "base": { "type": "string", "description": "Path of the base dataset file, for example datasets/coffee-places/de/munich.json." },
        "version": true,
        "generated_at": true,
        "licence": true,
        "attribution": true
      },
      "unevaluatedProperties": false
    },
    "entries": {
      "type": "object",
      "propertyNames": { "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 20, "maxLength": 600 }
        }
      }
    }
  }
}
