{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.roastbook.coffee/brew-methods/brew-methods.schema.v1.0.0.json",
  "title": "Open Coffee brew methods",
  "description": "Ways of brewing coffee (espresso, pour-over, V60, AeroPress, cold brew…), their typical parameters and what a coffee journal should record for each. Methods form a tree: a device-specific method such as v60 has the general method pour-over as parent. Part of Roastbook Open Coffee.",
  "type": "object",
  "required": [
    "$schema",
    "meta",
    "brew_methods"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^https://schema\\.roastbook\\.coffee/brew-methods/brew-methods\\.schema\\.v[0-9]+\\.[0-9]+\\.[0-9]+\\.json$"
    },
    "meta": {
      "type": "object",
      "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/dataset_meta",
      "unevaluatedProperties": false
    },
    "brew_methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/brew_method"
      }
    }
  },
  "$defs": {
    "range": {
      "title": "Range",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "typical": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "parameter": {
      "title": "Brew parameter",
      "enum": [
        "dose_g",
        "brew_water_g",
        "yield_g",
        "ratio",
        "grind_setting",
        "brew_time_seconds",
        "target_time_seconds",
        "water_temperature_celsius",
        "bloom_time_seconds",
        "bloom_water_g",
        "preinfusion_time_seconds",
        "preinfusion_pressure_bar",
        "brew_pressure_bar",
        "flow_rate_ml_per_second",
        "tamp_force_kg",
        "paper_filter_position",
        "distribution_method",
        "pour_count",
        "steep_time_seconds"
      ],
      "description": "Parameter keys shared with coffee journals such as Roastbook. ratio is brew water to coffee (16 means 1:16); for espresso it is yield to dose (2 means 1:2)."
    },
    "grind_size": {
      "title": "Grind size",
      "enum": [
        "extra_fine",
        "fine",
        "medium_fine",
        "medium",
        "medium_coarse",
        "coarse",
        "extra_coarse"
      ],
      "description": "Descriptive grind size; extra_fine is Turkish, fine espresso, medium filter, coarse French press and cold brew."
    },
    "brew_method": {
      "title": "Brew method",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "extraction",
        "description",
        "sources",
        "checked_at"
      ],
      "properties": {
        "id": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/id",
          "description": "Stable readable slug, e.g. v60, french-press. Never reused.",
          "examples": [
            "v60"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Other names in any language, e.g. Filterkaffee, drip."
        },
        "parent": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/id",
          "description": "The more general method, e.g. pour-over for v60."
        },
        "category": {
          "enum": [
            "espresso",
            "filter",
            "immersion",
            "pressure",
            "vacuum",
            "boiling",
            "cold"
          ],
          "description": "Family used for grouping: espresso (9-bar style pressure), filter (percolation through a filter), immersion (steep, then separate), pressure (non-espresso pressure such as AeroPress or moka pot), vacuum (siphon), boiling (cezve/ibrik), cold (cold water over hours)."
        },
        "extraction": {
          "enum": [
            "percolation",
            "immersion",
            "hybrid"
          ],
          "description": "Physical principle; matches equipment brewer.mechanism."
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600,
          "description": "Short neutral explanation in our own words."
        },
        "introduced_year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2100
        },
        "origin_country_code": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/country_code"
        },
        "equipment_types": {
          "type": "array",
          "uniqueItems": true,
          "description": "Equipment types needed, from the equipment schema's type list.",
          "items": {
            "$ref": "https://schema.roastbook.coffee/equipment/equipment.schema.v1.0.0.json#/$defs/type"
          }
        },
        "typical_parameters": {
          "title": "Typical parameters",
          "type": "object",
          "additionalProperties": false,
          "description": "Common starting ranges, not rules. Each value cites its source in field_provenance.",
          "properties": {
            "dose_g": {
              "$ref": "#/$defs/range"
            },
            "ratio": {
              "$ref": "#/$defs/range"
            },
            "water_temperature_celsius": {
              "$ref": "#/$defs/range"
            },
            "brew_time_seconds": {
              "$ref": "#/$defs/range"
            },
            "brew_pressure_bar": {
              "$ref": "#/$defs/range"
            },
            "grind_size": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/grind_size"
              }
            },
            "grind_d50_microns": {
              "$ref": "#/$defs/range",
              "description": "Median particle size in micrometres, comparable across grinders."
            }
          }
        },
        "recorded_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "description": "Parameters a coffee journal should offer when logging a brew with this method."
        },
        "typical_drinks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "xref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wikidata": {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            },
            "beanconqueror": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$",
              "description": "Beanconqueror PREPARATION_TYPES key, for app imports."
            }
          }
        },
        "image": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/image"
        },
        "method": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/method"
        },
        "confidence": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/confidence"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/source_ref"
          }
        },
        "checked_at": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/datetime"
        },
        "field_provenance": {
          "$ref": "https://schema.roastbook.coffee/common/common.schema.v1.0.0.json#/$defs/field_provenance_map"
        },
        "filter_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "paper",
              "metal",
              "cloth",
              "none"
            ]
          }
        }
      }
    }
  }
}
