          },
          "note": "boiling water if your kettle has no temperature control"
        },
        "grind_size": "medium_fine"
      },
      "scaling": {
        "water": "proportional",
        "timing": "fixed"
      },
      "phases": [
        {
          "id": "pour",
          "type": "pour",
          "duration_seconds": 10,
          "water_fraction": 1,
          "flow": "constant",
          "note": "to the 4 mark"
