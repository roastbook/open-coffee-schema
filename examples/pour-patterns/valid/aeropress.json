{
  "$schema": "https://schema.roastbook.coffee/pour-patterns/pour-patterns.schema.v0.5.1.json",
  "meta": {
    "licence": "CDLA-Permissive-2.0"
  },
  "pour_patterns": [
    {
      "id": "hoffmann-ultimate-aeropress",
      "name": "Ultimate AeroPress Technique",
      "kind": "recipe",
      "creator": "James Hoffmann",
      "published_year": 2021,
      "url": "https://www.youtube.com/watch?v=j6VlT_jUVPc",
      "brew_methods": [
        "aeropress"
      ],
      "flow_patterns": [
        "immersion"
      ],
      "description": "Brewed upright with no rinse or preheat. All the water goes on at once, the plunger goes in about 1 cm to stop the drip, and the coffee steeps for two minutes. A gentle swirl, 30 seconds to settle, then a gentle press all the way.",
      "defaults": {
        "brew_ratio": 18.2,
        "dose_g": 11,
        "brew_water_g": 200,
        "temperature": {
          "off_the_boil": true,
          "note": "for light roasts; for darker roasts use more coffee and a coarser grind"
        },
        "grind_size": "medium_fine"
      },
      "scaling": {
        "water": "proportional",
        "timing": "fixed"
      },
      "phases": [
        {
          "id": "pour",
          "type": "pour",
          "duration_seconds": 10,
          "water_fraction": 1,
          "flow": "constant",
          "note": "wet all the coffee while pouring"
        },
        {
          "id": "steep",
          "type": "hold",
          "duration_seconds": 120,
          "note": "plunger in about 1 cm to stop the drip"
        },
        {
          "id": "settle",
          "type": "hold",
          "duration_seconds": 30,
          "agitation": [
            "gentle_swirl"
          ],
          "note": "swirl gently, then wait"
        },
        {
          "id": "press",
          "type": "press",
          "duration_seconds": 30,
          "note": "gently, all the way; the recipe gives no press time"
        }
      ],
      "checked_at": "2026-11-11T09:00:00Z"
    },
    {
      "id": "wac-2017-miczka",
      "name": "World AeroPress Champion 2017",
      "kind": "recipe",
      "creator": "Paulina Miczka",
      "published_year": 2017,
      "url": "https://aeropress.com/blogs/w-a-c-aeropress-recipes/1st-paulina-miczka-england-2017",
      "brew_methods": [
        "aeropress"
      ],
      "flow_patterns": [
        "immersion"
      ],
      "description": "A concentrate of coffee ground as for a V60: 150 g of water mixed for 20 seconds, pressing from 1:05 to 1:35, then 150 to 200 g of water from the same kettle.",
      "defaults": {
        "brew_ratio": 4.3,
        "dose_g": 35,
        "brew_water_g": 150,
        "bypass_water_g": 150,
        "temperature": {
          "celsius": {
            "typical": 84
          }
        },
        "grind_size": "medium_fine"
      },
      "scaling": {
        "water": "proportional",
        "timing": "fixed"
      },
      "phases": [
        {
          "id": "pour",
          "type": "pour",
          "duration_seconds": 10,
          "water_fraction": 1,
          "flow": "constant"
        },
        {
          "id": "stir",
          "type": "hold",
          "duration_seconds": 20,
          "agitation": [
            "stir"
          ],
          "note": "mix with a stirrer or the back of a spoon"
        },
        {
          "id": "steep",
          "type": "hold",
          "duration_seconds": 35
        },
        {
          "id": "press",
          "type": "press",
          "duration_seconds": 30
        }
      ],
      "checked_at": "2026-11-11T09:00:00Z"
    },
    {
      "id": "immersion",
      "name": "Immersion",
      "kind": "flow",
      "description": "All the water goes on at once and the coffee steeps in it, usually with a stir, before the brew is separated from the grounds, for example by pressing it through the filter of an AeroPress.",
      "defaults": {
        "brew_ratio": 14.3,
        "dose_g": 14,
        "brew_water_g": 200
      },
      "phases": [
        {
          "id": "pour",
          "type": "pour",
          "duration_seconds": 10,
          "water_fraction": 1,
          "flow": "constant"
        },
        {
          "id": "steep",
          "type": "hold",
          "duration_seconds": 60,
          "agitation": [
            "stir"
          ]
        },
        {
          "id": "press",
          "type": "press",
          "duration_seconds": 30
        }
      ],
      "checked_at": "2026-11-11T09:00:00Z"
    }
  ]
}
