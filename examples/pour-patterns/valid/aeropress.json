        {
          "id": "stir",
          "type": "hold",
          "duration_seconds": 3,
          "agitation": [
            "stir"
          ],
          "note": "stir gently"
        },
        {
          "id": "steep",
          "type": "hold",
          "duration_seconds": 30,
          "note": "plunger in about 1 cm, pulled up slightly to stop the drip"
        },
        {
          "id": "press",
          "type": "press",
          "duration_seconds": 30,
          "note": "gentle, steady pressure until the hiss; the recipe gives no press time"
        }
